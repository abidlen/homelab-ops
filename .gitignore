# ==========================================
# 1. Node-Specific Runtime/Working Data
# ==========================================

# Nginx Proxy Manager (Only runs on nuc-04)
# Ignores live sqlite dbs, logs, and generated proxy config files
nodes/nuc-04/npm/data/
nodes/nuc-04/npm/letsencrypt/

# Keycloak (Only runs on nuc-04)
nodes/nuc-04/keycloak/data/

# Pi-hole (nuc-03 and nuc-04) - runtime data belongs on NVMe
nodes/*/pihole/etc-pihole/

# Chrony (Only runs on nuc-03)
nodes/nuc-03/chrony
nodes/*/ntp/data

# ==========================================
# 2. Secrets & Environment Files
# ==========================================
.env
*.env
!.env.example

# ==========================================
# 3. General Ignores
# ==========================================
*.log
*.tmp
*~
.DS_Store
.vscode/
.idea/

